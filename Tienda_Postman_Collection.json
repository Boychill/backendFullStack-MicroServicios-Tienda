{
  "info": {
    "name": "Tienda E-Commerce - Microservicios Completo",
    "description": "Coleccion completa con los endpoints del proyecto y flujos de usuario especializados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "clienteToken", "value": "", "type": "string" },
    { "key": "choferToken", "value": "", "type": "string" },
    { "key": "logisticaToken", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "1. Flujo Cliente",
      "description": "El cliente se loguea, anade direcciones, agrega al carrito, paga y revisa su historial.",
      "item": [
        {
          "name": "1.1 Login Cliente",
          "event": [ { "listen": "test", "script": { "exec": [ "var jsonData = pm.response.json();", "if(jsonData.token) pm.collectionVariables.set('clienteToken', jsonData.token);" ], "type": "text/javascript" } } ],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/api/auth/login", "body": { "mode": "raw", "raw": "{\"email\": \"cliente@tienda.com\", \"password\": \"123456\"}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "1.2 Anadir Direccion",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{clienteToken}}", "type": "string" } ] }, "method": "POST", "url": "{{baseUrl}}/api/perfiles/direccion", "body": { "mode": "raw", "raw": "{\"alias\": \"Casa\", \"direccionEscrita\": \"Av Principal 123, Santiago, Chile\", \"latitud\": -33.4489, \"longitud\": -70.6693}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "1.3 Agregar al Carrito",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{clienteToken}}", "type": "string" } ] }, "method": "POST", "url": "{{baseUrl}}/api/carrito/items", "body": { "mode": "raw", "raw": "{\"productoId\": 1, \"cantidad\": 1}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "1.4 Checkout (Pagar)",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{clienteToken}}", "type": "string" } ] }, "method": "POST", "url": "{{baseUrl}}/api/pedidos/checkout", "body": { "mode": "raw", "raw": "{\"direccionId\": 1, \"numeroTarjeta\": \"1111222233334444\"}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "1.5 Ver Mis Pedidos",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{clienteToken}}", "type": "string" } ] }, "method": "GET", "url": "{{baseUrl}}/api/pedidos/mis-pedidos" }
        }
      ]
    },
    {
      "name": "2. Flujo Admin",
      "item": [
        {
          "name": "2.1 Login Admin",
          "event": [ { "listen": "test", "script": { "exec": [ "var jsonData = pm.response.json();", "if(jsonData.token) pm.collectionVariables.set('adminToken', jsonData.token);" ], "type": "text/javascript" } } ],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/api/auth/login", "body": { "mode": "raw", "raw": "{\"email\": \"admin@tienda.com\", \"password\": \"123456\"}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "2.2 Crear Nuevo Producto",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{adminToken}}", "type": "string" } ] }, "method": "POST", "url": "{{baseUrl}}/api/productos", "body": { "mode": "raw", "raw": "{\"nombre\": \"Consola Videojuegos\", \"precio\": 499.0, \"categoria\": \"GAMING\"}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "2.3 Ingresar Stock",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{adminToken}}", "type": "string" } ] }, "method": "POST", "url": "{{baseUrl}}/api/inventario/ingreso", "body": { "mode": "raw", "raw": "{\"bodegaId\": 1, \"productoId\": 1, \"cantidadFisica\": 10}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "2.4 Reporte de Ventas",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{adminToken}}", "type": "string" } ] }, "method": "GET", "url": "{{baseUrl}}/api/reportes/ventas" }
        },
        {
          "name": "2.5 Ver Todas las Rutas Logistica (Admin)",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{adminToken}}", "type": "string" } ] }, "method": "GET", "url": "{{baseUrl}}/api/logistica/rutas" }
        },
        {
          "name": "2.6 Auto-Asignar Rutas Pendientes (Admin)",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{adminToken}}", "type": "string" } ] }, "method": "POST", "url": "{{baseUrl}}/api/logistica/auto-asignar", "body": { "mode": "raw", "raw": "", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "2.7 Asignar Chofer Manualmente (Admin)",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{adminToken}}", "type": "string" } ] }, "method": "PUT", "url": "{{baseUrl}}/api/logistica/1/asignar?choferId=4" }
        },
        {
          "name": "2.8 Reasignar a Otro Chofer (Admin)",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{adminToken}}", "type": "string" } ] }, "method": "PUT", "url": "{{baseUrl}}/api/logistica/1/reasignar?nuevoChoferId=4" }
        },
        {
          "name": "2.9 Cancelar Ruta (Admin)",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{adminToken}}", "type": "string" } ] }, "method": "DELETE", "url": "{{baseUrl}}/api/logistica/1/cancelar" }
        }
      ]
    },
    {
      "name": "3. Flujo Chofer",
      "description": "El chofer ve sus rutas asignadas y actualiza el estado de entrega.",
      "item": [
        {
          "name": "3.1 Login Chofer",
          "event": [ { "listen": "test", "script": { "exec": [ "var jsonData = pm.response.json();", "if(jsonData.token) pm.collectionVariables.set('choferToken', jsonData.token);" ], "type": "text/javascript" } } ],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/api/auth/login", "body": { "mode": "raw", "raw": "{\"email\": \"chofer@tienda.com\", \"password\": \"123456\"}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "3.2 Ver Mis Rutas Asignadas",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{choferToken}}", "type": "string" } ] }, "method": "GET", "url": "{{baseUrl}}/api/logistica/mis-rutas" }
        },
        {
          "name": "3.3 Marcar Ruta EN_RUTA",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{choferToken}}", "type": "string" } ] }, "method": "PUT", "url": "{{baseUrl}}/api/logistica/1/estado?estado=EN_RUTA" }
        },
        {
          "name": "3.4 Marcar Ruta ENTREGADO",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{choferToken}}", "type": "string" } ] }, "method": "PUT", "url": "{{baseUrl}}/api/logistica/1/estado?estado=ENTREGADO" }
        }
      ]
    },
    {
      "name": "4. Flujo Logistica",
      "description": "El operador de logistica gestiona las rutas: asigna, reasigna, cancela y usa auto-asignacion. Puede hacer todo lo que hace Admin en logistica.",
      "item": [
        {
          "name": "4.1 Login Logistica",
          "event": [ { "listen": "test", "script": { "exec": [ "var jsonData = pm.response.json();", "if(jsonData.token) pm.collectionVariables.set('logisticaToken', jsonData.token);" ], "type": "text/javascript" } } ],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/api/auth/login", "body": { "mode": "raw", "raw": "{\"email\": \"logistica@tienda.com\", \"password\": \"123456\"}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "4.2 Ver Rutas Pendientes",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{logisticaToken}}", "type": "string" } ] }, "method": "GET", "url": "{{baseUrl}}/api/logistica/pendientes" }
        },
        {
          "name": "4.3 Ver Todas las Rutas",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{logisticaToken}}", "type": "string" } ] }, "method": "GET", "url": "{{baseUrl}}/api/logistica/rutas" }
        },
        {
          "name": "4.4 Auto-Asignar Rutas Pendientes (Round-Robin)",
          "description": "Distribuye automaticamente todas las rutas PENDIENTES entre los choferes registrados.",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{logisticaToken}}", "type": "string" } ] }, "method": "POST", "url": "{{baseUrl}}/api/logistica/auto-asignar", "body": { "mode": "raw", "raw": "", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "4.5 Asignar Chofer Manualmente",
          "description": "Asigna un chofer especifico a una guia de despacho por su ID. Cambia estado a ASIGNADO.",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{logisticaToken}}", "type": "string" } ] }, "method": "PUT", "url": "{{baseUrl}}/api/logistica/1/asignar?choferId=4" }
        },
        {
          "name": "4.6 Reasignar a Otro Chofer",
          "description": "Cambia el chofer asignado a una ruta ya asignada.",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{logisticaToken}}", "type": "string" } ] }, "method": "PUT", "url": "{{baseUrl}}/api/logistica/1/reasignar?nuevoChoferId=4" }
        },
        {
          "name": "4.7 Cancelar Ruta",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{logisticaToken}}", "type": "string" } ] }, "method": "DELETE", "url": "{{baseUrl}}/api/logistica/1/cancelar" }
        },
        {
          "name": "4.8 Actualizar Estado de Ruta",
          "description": "Como manager, puede cambiar el estado de cualquier ruta sin importar quien sea el chofer asignado.",
          "request": { "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{logisticaToken}}", "type": "string" } ] }, "method": "PUT", "url": "{{baseUrl}}/api/logistica/1/estado?estado=EN_RUTA" }
        }
      ]
    },
    {
      "name": "5. Todos los Endpoints: AUTH & PERFIL",
      "item": [
        { "name": "Login", "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/login", "body": { "mode": "raw", "raw": "{\"email\":\"cliente@tienda.com\", \"password\":\"123456\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Count Users", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/count" } },
        { "name": "GET IDs Choferes", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/usuarios/choferes" } },
        { "name": "GET Direcciones", "request": { "method": "GET", "url": "{{baseUrl}}/api/perfiles/direcciones" } },
        { "name": "POST Direccion", "request": { "method": "POST", "url": "{{baseUrl}}/api/perfiles/direccion", "body": { "mode": "raw", "raw": "{\"alias\":\"Trabajo\", \"direccionEscrita\":\"Av Central, Lima, Peru\", \"latitud\":-12.0464, \"longitud\":-77.0428}", "options": { "raw": { "language": "json" } } } } },
        { "name": "PUT Direccion", "request": { "method": "PUT", "url": "{{baseUrl}}/api/perfiles/direcciones/1", "body": { "mode": "raw", "raw": "{\"alias\":\"Trabajo\", \"direccionEscrita\":\"Av Sur 123, Lima, Peru\", \"latitud\":-12.0500, \"longitud\":-77.0400}", "options": { "raw": { "language": "json" } } } } },
        { "name": "DELETE Direccion", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/perfiles/direcciones/1" } }
      ]
    },
    {
      "name": "6. Todos los Endpoints: CATALOGO",
      "item": [
        { "name": "GET Productos", "request": { "method": "GET", "url": "{{baseUrl}}/api/productos" } },
        { "name": "GET Producto by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/productos/1" } },
        { "name": "POST Producto", "request": { "method": "POST", "url": "{{baseUrl}}/api/productos", "body": { "mode": "raw", "raw": "{\"nombre\":\"Test Prod\", \"precio\":10.0, \"categoria\":\"TEST\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "PUT Stock Sync", "request": { "method": "PUT", "url": "{{baseUrl}}/api/productos/1/stock?stock=50" } },
        { "name": "PUT Cambiar Estado", "request": { "method": "PUT", "url": "{{baseUrl}}/api/productos/1/estado?activo=true" } }
      ]
    },
    {
      "name": "7. Todos los Endpoints: INVENTARIO",
      "item": [
        { "name": "GET Bodegas", "request": { "method": "GET", "url": "{{baseUrl}}/api/inventario/bodegas" } },
        { "name": "POST Bodega", "request": { "method": "POST", "url": "{{baseUrl}}/api/inventario/bodegas", "body": { "mode": "raw", "raw": "{\"nombre\":\"Bodega\", \"ubicacion\":\"Local\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "POST Ingreso", "request": { "method": "POST", "url": "{{baseUrl}}/api/inventario/ingreso", "body": { "mode": "raw", "raw": "{\"bodegaId\":1, \"productoId\":1, \"cantidadFisica\":10}", "options": { "raw": { "language": "json" } } } } },
        { "name": "POST Descuento Lote", "request": { "method": "POST", "url": "{{baseUrl}}/api/inventario/descuento-lote", "body": { "mode": "raw", "raw": "{\"items\":[{\"productoId\":1, \"cantidad\":1}], \"ordenId\":\"1\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "POST Revertir", "request": { "method": "POST", "url": "{{baseUrl}}/api/inventario/revertir", "body": { "mode": "raw", "raw": "{\"productoId\":1, \"cantidad\":2, \"ordenId\":\"1\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "GET Auditoria", "request": { "method": "GET", "url": "{{baseUrl}}/api/inventario/auditoria/1" } }
      ]
    },
    {
      "name": "8. Todos los Endpoints: CARRITO",
      "item": [
        { "name": "GET Carrito", "request": { "method": "GET", "url": "{{baseUrl}}/api/carrito" } },
        { "name": "POST Agregar Item", "request": { "method": "POST", "url": "{{baseUrl}}/api/carrito/items", "body": { "mode": "raw", "raw": "{\"productoId\":1, \"cantidad\":1}", "options": { "raw": { "language": "json" } } } } },
        { "name": "PUT Reducir Cantidad", "request": { "method": "PUT", "url": "{{baseUrl}}/api/carrito/items/1/reducir?cantidad=1" } },
        { "name": "DELETE Eliminar Item", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/carrito/items/1" } },
        { "name": "DELETE Vaciar Carrito", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/carrito/vaciar" } }
      ]
    },
    {
      "name": "9. Todos los Endpoints: PEDIDOS",
      "item": [
        { "name": "GET Todos los Pedidos", "request": { "method": "GET", "url": "{{baseUrl}}/api/pedidos" } },
        { "name": "GET Mis Pedidos", "request": { "method": "GET", "url": "{{baseUrl}}/api/pedidos/mis-pedidos" } },
        { "name": "POST Checkout", "request": { "method": "POST", "url": "{{baseUrl}}/api/pedidos/checkout", "body": { "mode": "raw", "raw": "{\"direccionId\": 1, \"numeroTarjeta\":\"1111222233334444\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "POST Devolucion", "request": { "method": "POST", "url": "{{baseUrl}}/api/pedidos/1/devolucion", "body": { "mode": "raw", "raw": "[{\"productoId\":1, \"cantidad\":1}]", "options": { "raw": { "language": "json" } } } } }
      ]
    },
    {
      "name": "10. Todos los Endpoints: PAGOS",
      "item": [
        { "name": "POST Procesar", "request": { "method": "POST", "url": "{{baseUrl}}/api/pagos/procesar", "body": { "mode": "raw", "raw": "{\"pedidoId\":1, \"montoTotal\":100.0, \"numeroTarjeta\":\"1111222233334444\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "POST Reembolso", "request": { "method": "POST", "url": "{{baseUrl}}/api/pagos/reembolso/1" } }
      ]
    },
    {
      "name": "11. Todos los Endpoints: LOGISTICA",
      "description": "Roles: ROLE_ADMIN y ROLE_LOGISTICA pueden gestionar rutas. ROLE_CHOFER solo puede ver sus rutas y actualizar estado de las suyas.",
      "item": [
        {
          "name": "GET Rutas Pendientes",
          "description": "Accesible por cualquier rol autenticado. Lista guias en estado PENDIENTE.",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/logistica/pendientes" }
        },
        {
          "name": "GET Mis Rutas (Chofer)",
          "description": "Devuelve las rutas asignadas al usuario autenticado.",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/logistica/mis-rutas" }
        },
        {
          "name": "GET Todas las Rutas (Manager)",
          "description": "Solo ROLE_ADMIN o ROLE_LOGISTICA. Lista todas las guias de despacho.",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/logistica/rutas" }
        },
        {
          "name": "POST Auto-Asignar Rutas (Manager)",
          "description": "Solo ROLE_ADMIN o ROLE_LOGISTICA. Distribuye en Round-Robin las guias PENDIENTES entre todos los choferes del sistema.",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/logistica/auto-asignar", "body": { "mode": "raw", "raw": "", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "PUT Asignar Chofer (Manager)",
          "description": "Asigna un choferId especifico a la guia. Sin parametro choferId el usuario se auto-asigna.",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/logistica/1/asignar?choferId=4" }
        },
        {
          "name": "PUT Reasignar Chofer (Manager)",
          "description": "Solo ROLE_ADMIN o ROLE_LOGISTICA. Cambia el chofer de una ruta ya asignada.",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/logistica/1/reasignar?nuevoChoferId=4" }
        },
        {
          "name": "PUT Actualizar Estado",
          "description": "ROLE_CHOFER solo puede actualizar su propia ruta. Managers pueden actualizar cualquier ruta. Estados: PENDIENTE, ASIGNADO, EN_RUTA, ENTREGADO",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/logistica/1/estado?estado=EN_RUTA" }
        },
        {
          "name": "DELETE Cancelar Ruta (Manager)",
          "description": "Solo ROLE_ADMIN o ROLE_LOGISTICA. Cancela la guia de despacho.",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/logistica/1/cancelar" }
        }
      ]
    },
    {
      "name": "12. Todos los Endpoints: NOTIFICACIONES",
      "item": [
        { "name": "GET Mis Notificaciones", "request": { "method": "GET", "url": "{{baseUrl}}/api/notificaciones" } },
        { "name": "PUT Marcar Leida", "request": { "method": "PUT", "url": "{{baseUrl}}/api/notificaciones/1/leer" } }
      ]
    },
    {
      "name": "13. Todos los Endpoints: REPORTES",
      "item": [
        { "name": "GET Reportes Ventas", "request": { "method": "GET", "url": "{{baseUrl}}/api/reportes/ventas" } }
      ]
    }
  ]
}